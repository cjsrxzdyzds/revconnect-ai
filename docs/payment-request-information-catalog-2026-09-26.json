  "findings": [
    {
      "code": "chat_evidence_is_separate",
      "finding": "Supporting purchase evidence can be added in conversation attachments rather than form upload answers."
    },
    {
      "code": "multiple_orders_per_request",
      "finding": "One reviewed case had screenshots showing multiple orders and multiple items; do not model request-to-order as one-to-one."
    },
    {
      "code": "request_evidence_amount_difference",
      "finding": "Visible order totals did not match the allocated amount on the inspected financial record. Cause and final payable amount remain unresolved; never overwrite either source amount."
    },
    {
      "code": "order_evidence_is_not_settlement",
      "finding": "Product/payment information in an order screenshot does not alone establish completed settlement or a compliant final receipt."
    },
    {
      "code": "partial_document_context",
      "finding": "The second image showed item, delivery, and payment information but no visible purchase date or order number. Those values must not be copied from a different order without verified linkage."
    },
    {
      "code": "prefilled_chat_links",
      "finding": "Some chat controls contain prefilled messages and setup parameters. Only an existing conversation without a prefilled message was opened; other channels were not initialized."
    },
    {
      "code": "completed_purchase_waiting_receipt",
      "finding": "The credit-card workflow explicitly describes its receipt stage as a completed transaction awaiting an itemized receipt; retain source evidence rather than infer bank settlement."
    },
    {
      "code": "mixed_sources_estimate_actual",
      "finding": "A hotel request had an earlier split-funding estimate in notes, different current funding values, and a staff note whose total reconciled with the current allocation and group-funds amounts in this sample. Do not generalize additive semantics to every financial view."
    },
    {
      "code": "archive_reference_not_archive_proof",
      "finding": "An existing private message used a merchant/organization/transaction/amount/fund-style reference. A reference alone does not verify that a receipt exists in Box."
    },
    {
      "code": "shared_route_workflow",
      "finding": "The inspected completed hotel case used the same stage labels as the inspected credit-card case. Request route and workflow template are separate dimensions."
    },
    {
      "code": "existing_private_conversation",
      "finding": "A two-message internal conversation exposed a system context message, staff note, sender, message IDs, calendar date, time, and participant context. Other empty or prefilled channels were not initialized."
    },
    {
      "code": "delayed_receipt_update_gap",
      "finding": "Whether new conversation evidence changes the parent request update timestamp is unverified; polling request timestamps alone may miss evidence."
    }
  ],
