{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revconnect-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "routes": [
    { "pattern": "cjsrxzdyzds.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
