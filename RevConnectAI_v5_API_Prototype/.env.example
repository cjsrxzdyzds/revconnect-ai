# The CampusGroups rss_groups and rss_events feeds are PUBLIC and need no
# credential. Leave both of these unset for normal operation.
#
# Setting an invalid value is worse than setting none at all: the feeds return
# HTTP 200 to an anonymous request but HTTP 403 when an unrecognized
# X-CG-API-Secret header is present. RevConnectAI therefore sends the header
# only when one of these variables is set.
#
# Set one only if GW later issues a real secret for these feeds.
# Do not commit a real credential.
# CG_API_KEY=
# CG_API_SECRET=

# Optional: the CampusGroups tenant to read. base_url is derived from this as
# https://<CG_SCHOOL_CODE>.campusgroups.com
# CG_SCHOOL_CODE=gwu
